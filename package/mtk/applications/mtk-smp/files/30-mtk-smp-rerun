#!/bin/sh

# smp.sh runs at START=99, before the Wi-Fi driver registers its interrupt,
# so the affinity meant for the radios is silently skipped and they stay on
# whichever core the GIC picks, usually CPU0. Run it again once a radio
# shows up.
case "$ACTION" in
	add) ;;
	*) exit 0 ;;
esac

case "$INTERFACE" in
	ra[0-9]*|rax[0-9]*|rai[0-9]*|apcli*) ;;
	*) exit 0 ;;
esac

[ -x /sbin/smp.sh ] && /sbin/smp.sh
