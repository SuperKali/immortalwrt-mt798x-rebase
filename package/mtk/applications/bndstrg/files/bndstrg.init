#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

# The wifi-device section that has band steering enabled
bs_device() {
	uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.bandsteering='1'$/\1/p" | head -n 1
}

start_service() {
	local dev val

	dev="$(bs_device)"
	[ -n "$dev" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/bndstrg

	# Optional tuning, on the same wifi-device section:
	#   bandsteering_rssi_up    5 GHz dBm needed to move up from 2.4 GHz (-70)
	#   bandsteering_rssi_down  5 GHz dBm below which to move down (-80)
	#   bandsteering_cooldown   seconds between two moves of a client (120)
	#   bandsteering_debug      1 to log every decision
	val="$(uci -q get wireless.$dev.bandsteering_rssi_up)"
	[ -n "$val" ] && procd_append_param command -u "$val"
	val="$(uci -q get wireless.$dev.bandsteering_rssi_down)"
	[ -n "$val" ] && procd_append_param command -d "$val"
	val="$(uci -q get wireless.$dev.bandsteering_cooldown)"
	[ -n "$val" ] && procd_append_param command -c "$val"
	[ "$(uci -q get wireless.$dev.bandsteering_debug)" = "1" ] &&
		procd_append_param command -v

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "wireless"
}
