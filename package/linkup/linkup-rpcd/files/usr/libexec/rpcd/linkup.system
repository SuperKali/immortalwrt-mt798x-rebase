#!/bin/sh
# LinkUp OS - linkup.system rpcd object (info / password / reboot / firmware / logs)
. /usr/share/linkup/lib.sh

case "$1" in
list)
	json_init
	json_add_object "info"; json_close_object
	json_add_object "needs_password"; json_close_object
	json_add_object "set_password"; json_add_string "password" ""; json_close_object
	json_add_object "reboot"; json_close_object
	json_add_object "firmware_validate"; json_add_string "path" ""; json_close_object
	json_add_object "sysupgrade"; json_add_string "path" ""; json_add_boolean "keep" 1; json_close_object
	json_add_object "logs"; json_add_int "lines" 200; json_close_object
	json_dump
	;;
call)
	case "$2" in
	info)
		b=$(ubus call system board 2>/dev/null)
		i=$(ubus call system info 2>/dev/null)
		ct=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
		case "$ct" in ''|*[!0-9]*) ctj=null ;; *) ctj=$((ct / 1000)) ;; esac
		# /proc/stat aggregate jiffies: total=sum of all fields, idle=idle+iowait (htop-style busy %)
		cs=$(awk '/^cpu /{t=0; for(n=2;n<=NF;n++) t+=$n; print t" "($5+$6); exit}' /proc/stat 2>/dev/null)
		ctot=${cs% *}; cidle=${cs#* }
		case "$ctot" in ''|*[!0-9]*) ctot=0 ;; esac
		case "$cidle" in ''|*[!0-9]*) cidle=0 ;; esac
		ncpu=$(grep -c '^cpu[0-9]' /proc/stat 2>/dev/null); case "$ncpu" in ''|*[!0-9]*|0) ncpu=1 ;; esac
		printf '%s\n%s\n' "$b" "$i" | jq -s -c --argjson ct "$ctj" --argjson tot "$ctot" --argjson idl "$cidle" --argjson nc "$ncpu" '{ok:true,
			model:(.[0].model//null), board:(.[0].board_name//null), kernel:(.[0].kernel//null),
			hostname:(.[0].hostname//null), release:(.[0].release.description//null),
			uptime:(.[1].uptime//0), localtime:(.[1].localtime//null), load:(.[1].load//null),
			memory:(.[1].memory//null), swap:(.[1].swap//null), cpu_temp:$ct,
			cpu_total:$tot, cpu_idle:$idl, cpu_count:$nc }' 2>/dev/null || linkup_err "info failed"
		;;
	needs_password)
		f=$(awk -F: '/^root:/{print $2}' /etc/shadow 2>/dev/null)
		case "$f" in ""|"!"|"*") np=true ;; *) np=false ;; esac
		echo "{\"ok\":true,\"needs_password\":$np}"
		;;
	set_password)
		read -r input
		pw=$(printf '%s' "$input" | jq -r '.password // empty')
		[ -n "$pw" ] || { linkup_err "password required"; exit 0; }
		if printf '%s:%s\n' root "$pw" | chpasswd >/dev/null 2>&1; then echo '{"ok":true}'
		else linkup_err "chpasswd failed"; fi
		;;
	reboot)
		( sleep 1; ubus call system reboot ) >/dev/null 2>&1 &
		echo '{"ok":true,"note":"rebooting"}'
		;;
	firmware_validate)
		read -r input
		path=$(printf '%s' "$input" | jq -r '.path // empty')
		[ -n "$path" ] || { linkup_err "path required"; exit 0; }
		ubus call system validate_firmware_image "{\"path\":\"$path\"}" 2>/dev/null \
			| jq -c '{ok:true, valid:(.valid//false), forceable:(.forceable//false), allow_backup:(.allow_backup//true)}' \
			2>/dev/null || linkup_err "validate failed"
		;;
	sysupgrade)
		read -r input
		path=$(printf '%s' "$input" | jq -r '.path // empty')
		keep=$(printf '%s' "$input" | jq -r 'if .keep==false then "-n" else "" end')
		[ -f "$path" ] || { linkup_err "image not found"; exit 0; }
		v=$(ubus call system validate_firmware_image "{\"path\":\"$path\"}" 2>/dev/null | jq -r '.valid // false')
		[ "$v" = "true" ] || { linkup_err "invalid firmware image"; exit 0; }
		( sleep 1; /sbin/sysupgrade $keep "$path" ) >/dev/null 2>&1 &
		echo '{"ok":true,"note":"sysupgrade started"}'
		;;
	logs)
		read -r input 2>/dev/null
		n=$(printf '%s' "$input" | jq -r '.lines // 200' 2>/dev/null)
		case "$n" in ''|*[!0-9]*) n=200 ;; esac
		logread 2>/dev/null | tail -n "$n" | jq -R -s -c '{ok:true, log:.}'
		;;
	*)
		linkup_err "unknown method"
		;;
	esac
	;;
esac
